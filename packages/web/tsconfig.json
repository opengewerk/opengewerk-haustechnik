{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    // Vite's own types and those of the plugin of the worker: the second
    // declares `virtual:pwa-register`, which exists only while the plugin is
    // running and would otherwise be an unresolved import in every check.
    // Node types stay out: this package runs in a browser.
    "types": ["vite/client", "vite-plugin-pwa/client"],
    "jsx": "react-jsx"
  },
  "include": ["src", "vite.config.ts", "vitest.config.ts", "test-setup.ts"]
}
