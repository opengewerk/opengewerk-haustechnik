{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "remoteCache": {
    "enabled": false
  },
  "globalDependencies": [
    "eslint.config.js",
    "prettier.config.js",
    "tsconfig.base.json",
    "vitest.shared.ts",
    "upstream/opengewerk/eslint.config.js",
    "upstream/opengewerk/eslint.shared.js",
    "upstream/opengewerk/tsconfig.base.json",
    "upstream/opengewerk/vitest.shared.ts"
  ],
  "globalPassThroughEnv": ["DATABASE_URL"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "@opengewerk/haustechnik-catalogue#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/pakete/**", "$TURBO_ROOT$/package.json"],
      "outputs": ["dist/**"]
    },
    "@opengewerk/haustechnik-server#test": {
      "dependsOn": ["^build", "@opengewerk/platform-server#test"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/docs/konzept/Planungskonzept.md",
        "$TURBO_ROOT$/CHANGELOG.md"
      ]
    }
  }
}
