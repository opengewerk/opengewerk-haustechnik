          "required": true,
          "options": [
            { "value": "done", "label": "Erledigt" },
            { "value": "not_needed", "label": "Entfällt" }
          ]
        },
        {
          "kind": "choice",
          "key": "residues",
          "label": "Behälter und Leitungen im Arbeitsbereich frei von brennbaren Resten",
