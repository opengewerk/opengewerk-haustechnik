    {
      "key": "measurements",
      "title": "Messen",
      "hint": "DIN VDE 0100-600, Abschnitt 6.4.3, je Stromkreis aus dem Stromkreisverzeichnis.",
      "fields": [
        {
          "kind": "group",
          "key": "circuits",
          "label": "Messen je Stromkreis",
          "repeat": "circuits",
          "fields": [
            {
              "kind": "measurement",
              "key": "protective_conductor",
              "label": "Durchgängigkeit des Schutzleiters RPE",
              "unit": "ohms",
              "decimals": 2
            },
            {
              "kind": "measurement",
              "key": "insulation_resistance",
              "label": "Isolationswiderstand Riso",
              "unit": "megaohms",
              "decimals": 2,
              "limit": {
                "kind": "at_least",
                "rule": "insulation_minimum_up_to_500v"
              }
            },
            {
              "kind": "measurement",
              "key": "loop_impedance",
              "label": "Schleifenimpedanz Zs",
              "unit": "ohms",
              "decimals": 2,
              "limit": {
                "kind": "loop_impedance"
              }
            },
            {
              "kind": "measurement",
              "key": "rcd_trip_current",
              "label": "Auslösestrom IΔ",
              "unit": "milliamperes",
              "decimals": 1,
              "limit": {
                "kind": "rcd_trip_current"
              }
            },
            {
              "kind": "measurement",
              "key": "rcd_trip_time",
              "label": "Auslösezeit tΔ",
              "unit": "milliseconds",
              "decimals": 0,
              "limit": {
                "kind": "at_most",
                "rule": "rcd_trip_time_maximum"
              }
            },
            {
              "kind": "check_point",
              "key": "circuit_ok",
              "label": "Stromkreis in Ordnung"
            },
            {
              "kind": "text",
              "key": "remark",
              "label": "Bemerkung",
              "multiline": true
            }
          ]
        }
      ]
    },
    {
