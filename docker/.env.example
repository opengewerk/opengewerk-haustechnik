# Template for the .env next to the compose file. Nobody has to fill it in by
# hand: the first start copies it, makes every secret marked "bitte-ersetzen"
# and asks for the address. Only the names of what it made are printed.
#
#   sh docker/start.sh
#
# The .env is the only file holding credentials. It does not belong in the
# repository, the .gitignore keeps it out, and setup.sh makes it readable by
# its owner only. What a Betreiber changes lives in the web interface, not
# here; what is here is needed before the interface can start.
#
# Whoever fills it in by hand makes every secret on its own, and an instance
# that still finds a placeholder refuses to start:
#
#   openssl rand -hex 32
#
# Hex and not base64: the passwords end up inside connection strings, and a
# "/" or "@" in one splits the address at the wrong place.
#
# The renderer for PDFs, mail and push are not here yet. They come with the
# services behind them (opengewerk-haustechnik#23), and their lines with them;
# setup.sh adds a line a newer template brings to an existing .env.

# The superuser of the database. The application never uses it, only the
# container itself while setting up, and the backup.
POSTGRES_PASSWORD=bitte-ersetzen-1

# The role that owns the tables. It migrates, nothing else. In the database it
# is called opengewerk_owner, as the foundation names it.
HAUSTECHNIK_OWNER_PASSWORD=bitte-ersetzen-2

# The role the application works with, opengewerk_app in the database. The
# separation of the Betreiber applies to it, which is why it is the only one
# allowed to see data.
HAUSTECHNIK_APP_PASSWORD=bitte-ersetzen-3

# Signs the session cookies and encrypts the second factors. Same rule as
# above, "openssl rand -hex 32", and one more thing: this one belongs in the
# backup of the installation. Changing it signs everybody out and makes every
# second factor that was already set up unreadable.
SESSION_SECRET=bitte-ersetzen-4

# The code the setup in the browser asks for, while the instance has neither a
# Betreiber nor an account. Without it a freshly started instance would take
# its first run from whoever reaches the address first. Whoever can read this
# file can get at the server, and that is who is meant to set it up.
#
# setup.sh makes it like every key, only shorter, so that it can be typed off
# a terminal: eight characters without 0, O, 1, I and L, as XXXX-XXXX. It
# prints the name and never the code; start.sh says where to find it while the
# instance is still empty. Once it is set up, the code opens nothing.
SETUP_CODE=bitte-ersetzen-5

# The addresses a browser may send an authenticated request from, separated by
# commas. Origin only: scheme, host, optional port, no path and no slash at the
# end, because that is what a browser puts in the Origin header.
#
# A host name of its own, and not the one of an OpenGewerk on the same server
# with another port: a browser keeps cookies per host name and not per port,
# so two applications under one name would sign each other out.
#
# This is the protection against a form on a stranger's page posting here with
# somebody's cookie attached. There is no default: one would switch it off in
# exactly the installation whose operator did not think about it.
TRUSTED_ORIGINS=https://haustechnik.example.de

# Recognises nobody while this is "true", the sign in included. The instance
# starts, migrates and answers its health check, and hands out no data at all.
# For a restore or a migration window. Anything other than "true" or "false" is
# refused rather than read as a no.
CLOSED=false

# Which port the application answers on, on this machine. Loopback only; a
# reverse proxy with TLS belongs in front of it. 23800 and not the 23700 of
# OpenGewerk, so that both run on one server.
HAUSTECHNIK_PORT=23800

# Which release runs. Empty is the usual case: a checkout of the source builds
# the images. Releases with signed images come with the first version.
HAUSTECHNIK_VERSION=

# --- Backup ---------------------------------------------------------------
# The nightly backup runs by itself. By hand, before an update, and the
# restore:
#
#   docker compose -f docker/compose.yaml --profile backup run --rm backup backup.sh
#   docker compose -f docker/compose.yaml --profile backup run --rm backup restore.sh latest

# How many generations to keep. Older ones are removed after a run.
BACKUP_KEEP=14

# Where the archives land. A named volume by default, which survives a
# "docker compose down" but not the disk. An installation that means it puts
# an absolute path to another machine here, mounted over NFS or SMB. A folder
# shared with an OpenGewerk is fine: the archives are named after the
# database, and each application finds, keeps and removes only its own.
#
#   BACKUP_TARGET=/mnt/nas/sicherungen
BACKUP_TARGET=backups

# The public key an archive is encrypted to. Leaving this empty writes the
# archive in the clear, and it holds the data of every Betreiber and the audit
# log. Create a key pair with:
#
#   docker compose -f docker/compose.yaml --profile backup run --rm --no-deps backup age-keygen
#
# The line starting with "age1" is the public key and goes here. The line
# starting with "AGE-SECRET-KEY-" is the private one: it belongs somewhere
# other than this machine, because a backup encrypted with a key that lies
# next to it protects against nothing.
BACKUP_AGE_RECIPIENT=

# Only needed to restore an encrypted archive, and only then. It points at a
# file holding the private key, mounted into the container for that one run:
#
#   docker compose -f docker/compose.yaml --profile backup run --rm \
#     -v /pfad/zum/schluessel.txt:/schluessel.txt:ro \
#     -e BACKUP_AGE_IDENTITY=/schluessel.txt \
#     backup restore.sh latest
BACKUP_AGE_IDENTITY=
