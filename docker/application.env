# The names this application goes by in the scripts of the foundation, in one
# place (ADR 0010 in the repository opengewerk, opengewerk-haustechnik#14).
# setup.sh and start.sh are the foundation's and lie in
# upstream/opengewerk/docker; start.sh beside this file runs them against this
# folder. Shell syntax, read with "." by both scripts and never by Docker
# Compose. The name of the Compose project, the images and the default port
# stand in compose.yaml, the address the template carries until the real one
# is given in .env.example; the scripts read them there.

# What the application is called, at the start of every line the scripts say.
APPLICATION_NAME='OpenGewerk Haustechnik'

# The prefix of the variables that are this application's own, in the .env and
# in the environment of a script: HAUSTECHNIK_VERSION, HAUSTECHNIK_PORT,
# HAUSTECHNIK_ADDRESS and the passwords of the two database roles. Another than
# the Handwerkersoftware's on purpose: both run side by side on one server, and
# a value meant for the one must not reach the other (ADR 0001, point 11).
APPLICATION_PREFIX='HAUSTECHNIK'

# An address the script names as an example when it asks for the real one.
APPLICATION_EXAMPLE_ADDRESS='https://haustechnik.example.de'
